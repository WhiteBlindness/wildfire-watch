{
  "name": "wildfire-watch",
  "main": ".open-next/worker.js",
  "compatibility_date": "2025-09-23",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "vars": {
    "DATA_SOURCE": "firms"
  },
  "kv_namespaces": [
    {
      "binding": "FIRMS_CACHE",
      "id": "6f6588ad3c434c3aad5767d50f91f730"
    }
  ]
}
