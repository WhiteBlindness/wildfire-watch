{
  "name": "wildfire-watch",
  "main": "workers/app-entry.ts",
  // The OpenNext output (.open-next/worker.js, imported by workers/app-entry.ts,
  // plus .open-next/assets) is produced by the Cloudflare Workers Builds *build*
  // stage running `npm run build:cloudflare`. Wrangler's deploy/upload stage then
  // only bundles and uploads that already-generated output — it deliberately has
  // no `build.command`, so OpenNext is built exactly once, in the build stage.
  "compatibility_date": "2025-09-23",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "vars": {
    "DATA_SOURCE": "firms"
  },
  "kv_namespaces": [
    {
      "binding": "FIRMS_CACHE",
      "id": "6f6588ad3c434c3aad5767d50f91f730"
    }
  ],
  "triggers": {
    "crons": ["0 * * * *"]
  },
  "observability": {
    "enabled": true
  }
}
