{
  "name": "wildfire-watch",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test:map": "esbuild ./src/components/map/mapPresentation.test.ts --bundle --platform=node --format=cjs --outfile=./node_modules/.cache/wildfire-watch/map-presentation.test.cjs && node ./node_modules/.cache/wildfire-watch/map-presentation.test.cjs",
    "test:detail-state": "esbuild ./src/components/map/detailState.test.ts --bundle --platform=node --format=cjs --outfile=./node_modules/.cache/wildfire-watch/detail-state.test.cjs && node ./node_modules/.cache/wildfire-watch/detail-state.test.cjs",
    "test:media-query": "esbuild ./src/lib/media-query.test.ts --bundle --platform=node --format=cjs --outfile=./node_modules/.cache/wildfire-watch/media-query.test.cjs && node ./node_modules/.cache/wildfire-watch/media-query.test.cjs",
    "test:viirs": "esbuild ./src/lib/wildfire/viirs.test.ts --bundle --platform=node --format=cjs --outfile=./node_modules/.cache/wildfire-watch/viirs.test.cjs && node ./node_modules/.cache/wildfire-watch/viirs.test.cjs",
    "test:language": "node --test tests/document-language.test.mjs",
    "test:typography": "node --test tests/typography.test.mjs",
    "test:air-quality": "esbuild ./src/app/api/air-quality/route.test.ts --bundle --platform=node --format=cjs --outfile=./node_modules/.cache/wildfire-watch/air-quality.test.cjs && node ./node_modules/.cache/wildfire-watch/air-quality.test.cjs",
    "test:sampling": "esbuild ./workers/firms-ingest.test.ts --bundle --platform=node --format=cjs --outfile=./node_modules/.cache/wildfire-watch/firms-ingest.test.cjs && node ./node_modules/.cache/wildfire-watch/firms-ingest.test.cjs",
    "test:temporal": "esbuild ./src/lib/wildfire/temporal.test.ts --bundle --platform=node --format=cjs --outfile=./node_modules/.cache/wildfire-watch/temporal.test.cjs && node ./node_modules/.cache/wildfire-watch/temporal.test.cjs",
    "test:overview-metrics": "esbuild ./src/lib/wildfire/overview-metrics.test.ts --bundle --platform=node --format=cjs --outfile=./node_modules/.cache/wildfire-watch/overview-metrics.test.cjs && node ./node_modules/.cache/wildfire-watch/overview-metrics.test.cjs",
    "test:rss": "esbuild ./src/lib/news/rss.test.ts --bundle --platform=node --format=cjs --outfile=./node_modules/.cache/wildfire-watch/rss.test.cjs && node ./node_modules/.cache/wildfire-watch/rss.test.cjs",
    "test:news-route": "esbuild ./src/app/api/news/route.test.ts --bundle --platform=node --format=cjs --outfile=./node_modules/.cache/wildfire-watch/news-route.test.cjs && node ./node_modules/.cache/wildfire-watch/news-route.test.cjs",
    "test:fire-detail": "esbuild ./src/app/api/fires/detail/route.test.ts --bundle --platform=node --format=cjs --outfile=./node_modules/.cache/wildfire-watch/fire-detail.test.cjs && node ./node_modules/.cache/wildfire-watch/fire-detail.test.cjs",
    "test:legal": "esbuild ./src/lib/legal/content.test.ts --bundle --platform=node --format=cjs --outfile=./node_modules/.cache/wildfire-watch/legal-content.test.cjs && node ./node_modules/.cache/wildfire-watch/legal-content.test.cjs",
    "test:compliance": "node --test tests/compliance.test.mjs",
    "test": "npm run test:map && npm run test:detail-state && npm run test:media-query && npm run test:viirs && npm run test:language && npm run test:typography && npm run test:air-quality && npm run test:sampling && npm run test:temporal && npm run test:overview-metrics && npm run test:rss && npm run test:news-route && npm run test:fire-detail && npm run test:legal && npm run test:compliance",
    "build:cloudflare": "opennextjs-cloudflare build",
    "deploy:cloudflare": "opennextjs-cloudflare deploy",
    "preview": "npm run build:cloudflare && opennextjs-cloudflare preview",
    "deploy": "npm run build:cloudflare && npm run deploy:cloudflare",
    "cf-typegen": "wrangler types --env-interface CloudflareEnv cloudflare-env.d.ts"
  },
  "dependencies": {
    "@base-ui/react": "^1.6.0",
    "@turf/turf": "^7.3.5",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "d3-geo": "^3.1.1",
    "lucide-react": "^1.28.0",
    "maplibre-gl": "^5.24.0",
    "next": "^16.2.12",
    "next-themes": "^0.4.6",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-map-gl": "^8.1.1",
    "server-only": "^0.0.1",
    "shadcn": "^4.16.0",
    "tailwind-merge": "^3.6.0",
    "topojson-client": "^3.1.0",
    "tw-animate-css": "^1.4.0",
    "world-atlas": "^2.0.2"
  },
  "devDependencies": {
    "@opennextjs/cloudflare": "^1.20.2",
    "@tailwindcss/postcss": "^4",
    "@types/d3-geo": "^3.1.1",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/topojson-client": "^3.1.5",
    "esbuild": "^0.25.4",
    "eslint": "^9",
    "eslint-config-next": "^16.2.12",
    "tailwindcss": "^4",
    "typescript": "^5",
    "wrangler": "^4.114.0"
  }
}
