# Local development secrets. Copy to .dev.vars for `wrangler dev` / preview.
# In production each value is a Cloudflare Worker secret (wrangler secret put).

# Free NASA FIRMS API key, used only by the scheduled ingest and the detail route.
# Register at: https://firms.modaps.eosdis.nasa.gov/api/map_key/
FIRMS_MAP_KEY=

# Free OpenAQ v3 API key, kept server-side for the local PM2.5/AQI lookup.
# Register at https://explore.openaq.org/register and set the same value as a
# Cloudflare Worker secret named OPENAQ_API_KEY before production use.
OPENAQ_API_KEY=

# Optional ingest alerts. Configure either, both or neither; nothing else depends on them.
# Discord: a channel webhook URL (Channel settings → Integrations → Webhooks).
DISCORD_WEBHOOK_URL=
# Telegram: a bot token from @BotFather and the numeric chat id that should receive alerts.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
