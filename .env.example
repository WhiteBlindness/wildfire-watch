# Which wildfire data source to use: "firms" or "mock".
# Leave unset to auto-select: firms when FIRMS_MAP_KEY is present, mock otherwise.
DATA_SOURCE=firms

# Free NASA FIRMS API key. Register at:
# https://firms.modaps.eosdis.nasa.gov/api/map_key/
FIRMS_MAP_KEY=

# Free OpenAQ v3 API key, kept server-side for the local PM2.5/AQI lookup.
# Register at https://explore.openaq.org/register and set the same value as a
# Cloudflare Worker secret named OPENAQ_API_KEY before production use.
OPENAQ_API_KEY=
